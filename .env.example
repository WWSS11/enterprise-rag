# 后端应用配置模板
# 复制为根目录 .env 后填写：cp .env.example .env
# .env 仅供后端应用使用并已被 Git 忽略；不要把真实密码、Token 或 API Key 提交到仓库。
# 中间件容器的部署账号和密码在 infra/.env，前端开发变量在 frontend/.env。

# ==============================================================================
# 应用运行环境
# ==============================================================================
APP_APP_NAME=RAG Study Helper Enterprise
# 可选值建议：local、test、staging、production。
APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
APP_API_V1_PREFIX=/api/v1
# JSON 数组；填写允许访问后端 API 的前端来源，不要在生产环境使用 *。
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]

# ==============================================================================
# 后端使用的数据服务连接
# ==============================================================================
# 本地开发执行 scripts/dev.sh 时，会依据 infra/.env 自动同步下列连接串。
# 如果后端运行在容器内，请把主机地址改为对应的 Compose 服务名。
APP_POSTGRES_DSN=postgresql+asyncpg://rag:rag_change_me@127.0.0.1:5432/rag_study_helper
APP_POSTGRES_SYNC_DSN=postgresql+psycopg://rag:rag_change_me@127.0.0.1:5432/rag_study_helper
APP_REDIS_URL=redis://:redis_change_me@127.0.0.1:16379/0
APP_CELERY_BROKER_URL=redis://:redis_change_me@127.0.0.1:16379/1
APP_CELERY_RESULT_BACKEND=redis://:redis_change_me@127.0.0.1:16379/2

# ==============================================================================
# Milvus
# ==============================================================================
APP_MILVUS_URI=http://127.0.0.1:19530
# 未启用 Milvus 鉴权时保持为空。
APP_MILVUS_TOKEN=
APP_MILVUS_DB_NAME=default
APP_MILVUS_COLLECTION=rag_chunks_v3
APP_MILVUS_COLLECTION_ALIAS=rag_chunks_current
APP_MILVUS_REBUILD_RETAINED_COLLECTIONS=2

# ==============================================================================
# 模型服务凭据与地址
# ==============================================================================
# 模型名称、分块、检索、rerank、上下文和摄取参数统一维护在 config/rag.yaml。
# 如需临时覆盖 YAML，也可以使用同名 APP_* 环境变量，但不要重复写入本模板。
APP_CHAT_BASE_URL=https://api.deepseek.com/v1
APP_CHAT_API_KEY=
APP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
APP_EMBEDDING_API_KEY=
APP_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# config/rag.yaml 中启用 rerank 时必须填写。
APP_RERANK_API_KEY=

# ==============================================================================
# 文件摄取与本地存储
# ==============================================================================
APP_UPLOAD_DIR=data/uploads
APP_CONNECTOR_DIR=data/connectors
# JSON 对象；键是来源名称，值是后端可读取的目录。
APP_SCAN_ROOTS={"default":"data/import"}
APP_MAX_UPLOAD_MB=50
# JSON 数组；通常保留默认值即可。
APP_SUPPORTED_DOCUMENT_EXTENSIONS=[".txt",".md",".csv",".json",".xml",".pdf",".docx",".pptx",".xlsx",".xlsm",".xls",".html",".htm"]

# ==============================================================================
# 限流、会话与对话历史
# ==============================================================================
APP_CHAT_RATE_LIMIT_PER_MINUTE=30
APP_CHAT_RATE_LIMIT_PER_TENANT_PER_MINUTE=300
APP_CHAT_DAILY_LIMIT_PER_USER=1000
APP_CHAT_DAILY_LIMIT_PER_TENANT=100000
# Redis 暂时不可用时是否放行请求；生产环境建议 false。
APP_RATE_LIMIT_FAIL_OPEN=false
APP_SESSION_TTL_SECONDS=86400
APP_CONVERSATION_HISTORY_MESSAGES=20

# ==============================================================================
# 身份认证
# ==============================================================================
# 可选值：oidc 或 trusted_header。
APP_AUTH_MODE=oidc
# 仅 trusted_header 模式使用；生产环境必须设置为足够长的随机值。
APP_IDENTITY_HEADER_SECRET=
# JSON 数组。
APP_ADMIN_USER_IDS=["admin"]

# OIDC 配置；仅 APP_AUTH_MODE=oidc 时生效。
APP_OIDC_ISSUER=http://127.0.0.1:18080/realms/enterprise-rag
APP_OIDC_AUDIENCE=enterprise-rag-api
# 留空时由 issuer 推导；特殊部署可显式填写完整 JWKS URL。
APP_OIDC_JWKS_URL=
APP_OIDC_ALGORITHMS=["RS256"]
APP_OIDC_TOKEN_TYPES=["JWT","at+jwt","application/at+jwt"]
APP_OIDC_TENANT_CLAIM=tenant_id
APP_OIDC_ROLES_CLAIM=realm_access.roles
APP_OIDC_GROUPS_CLAIM=groups
APP_OIDC_ADMIN_ROLE=rag-admin
APP_OIDC_JWKS_CACHE_SECONDS=300
APP_OIDC_HTTP_TIMEOUT_SECONDS=10
APP_OIDC_CLOCK_SKEW_SECONDS=30
APP_OIDC_MAX_TOKEN_LENGTH=16384

# ==============================================================================
# 飞书知识库同步（可选）
# ==============================================================================
APP_FEISHU_ENABLED=false
APP_FEISHU_APP_ID=
APP_FEISHU_APP_SECRET=
APP_FEISHU_SPACE_ID=
APP_FEISHU_TENANT_ID=default
APP_FEISHU_RUN_AS_USER=feishu-sync
APP_FEISHU_KNOWLEDGE_BASE_ID=
APP_FEISHU_BASE_URL=https://open.feishu.cn/open-apis
APP_FEISHU_SYNC_PAGE_SIZE=50
