# Production application template. Copy to .env.production and replace every REQUIRED value.
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
APP_API_V1_PREFIX=/api/v1
# REQUIRED: JSON list containing the public frontend origin, for example ["https://rag.company.com"]
APP_CORS_ORIGINS=[]

# Compose overrides these addresses with container service names. Keep them for non-Compose tooling.
APP_POSTGRES_DSN=postgresql+asyncpg://rag:CHANGE_ME@postgres:5432/rag_study_helper
APP_POSTGRES_SYNC_DSN=postgresql+psycopg://rag:CHANGE_ME@postgres:5432/rag_study_helper
APP_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
APP_CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/1
APP_CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/2

APP_MILVUS_URI=http://milvus:19530
APP_MILVUS_TOKEN=
APP_MILVUS_DB_NAME=default
APP_MILVUS_COLLECTION=rag_chunks_v3
APP_MILVUS_COLLECTION_ALIAS=rag_chunks_current
APP_MILVUS_REBUILD_RETAINED_COLLECTIONS=2
APP_EMBEDDING_DIMENSION=1024

APP_CHAT_BASE_URL=https://api.deepseek.com/v1
# REQUIRED
APP_CHAT_API_KEY=
APP_CHAT_MODEL=deepseek-chat
APP_CHAT_TEMPERATURE=0.2

APP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# REQUIRED
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

APP_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# REQUIRED when reranking is enabled
APP_RERANK_API_KEY=
APP_RERANK_MODEL=BAAI/bge-reranker-v2-m3
APP_RERANK_ENABLED=true
APP_RERANK_TIMEOUT_SECONDS=30
APP_RERANK_MAX_ATTEMPTS=2
APP_RERANK_RETRY_BASE_SECONDS=0.5

APP_RETRIEVAL_TOP_K=40
APP_RERANK_TOP_K=8
APP_SCORE_THRESHOLD=0.0
APP_HYBRID_RRF_K=60
APP_ATOMIC_CHUNK_MAX_TOKENS=160
APP_RETRIEVAL_CHUNK_TARGET_TOKENS=320
APP_RETRIEVAL_CHUNK_OVERLAP_TOKENS=48
APP_PARENT_CHUNK_MAX_TOKENS=960
APP_EMBEDDING_CONTEXT_MAX_TOKENS=400
APP_SEMANTIC_CHUNKING_ENABLED=true
APP_SEMANTIC_BREAK_THRESHOLD=0.58
APP_SEMANTIC_BREAK_PERCENTILE=15
APP_CONTEXT_MAX_TOKENS=4000
APP_CONTEXT_MAX_PARENTS=5
APP_CONTEXT_NEIGHBOR_WINDOW=1
APP_CONTEXT_DOCUMENT_DIVERSITY_ENABLED=true
APP_CONTEXT_DOCUMENT_DIVERSITY_MIN_SCORE_RATIO=0.1
APP_UPLOAD_DIR=data/uploads
APP_CONNECTOR_DIR=data/connectors
APP_SCAN_ROOTS={"default":"data/import"}
APP_MAX_UPLOAD_MB=50
APP_CHUNK_SIZE=480
APP_CHUNK_OVERLAP=80
APP_EMBEDDING_BATCH_SIZE=16
APP_ALLOW_PARTIAL_INGESTION=false
APP_CHAT_RATE_LIMIT_PER_MINUTE=30
APP_CHAT_RATE_LIMIT_PER_TENANT_PER_MINUTE=300
APP_CHAT_DAILY_LIMIT_PER_USER=1000
APP_CHAT_DAILY_LIMIT_PER_TENANT=100000
APP_RATE_LIMIT_FAIL_OPEN=false
APP_SESSION_TTL_SECONDS=86400
APP_CONVERSATION_HISTORY_MESSAGES=20

APP_AUTH_MODE=oidc
APP_IDENTITY_HEADER_SECRET=
APP_ADMIN_USER_IDS=["admin"]
# REQUIRED: public HTTPS issuer, for example https://id.company.com/realms/enterprise-rag
APP_OIDC_ISSUER=
APP_OIDC_AUDIENCE=enterprise-rag-api
# Optional explicit internal JWKS URL. Leave empty to use OIDC discovery.
APP_OIDC_JWKS_URL=
APP_OIDC_ALGORITHMS=["RS256"]
APP_OIDC_TOKEN_TYPES=["JWT","at+jwt","application/at+jwt"]
APP_OIDC_TENANT_CLAIM=tenant_id
APP_OIDC_ROLES_CLAIM=realm_access.roles
APP_OIDC_GROUPS_CLAIM=groups
APP_OIDC_ADMIN_ROLE=rag-admin
APP_OIDC_JWKS_CACHE_SECONDS=300
APP_OIDC_HTTP_TIMEOUT_SECONDS=10
APP_OIDC_CLOCK_SKEW_SECONDS=30
APP_OIDC_MAX_TOKEN_LENGTH=16384

APP_FEISHU_ENABLED=false
APP_FEISHU_APP_ID=
APP_FEISHU_APP_SECRET=
APP_FEISHU_SPACE_ID=
APP_FEISHU_TENANT_ID=default
APP_FEISHU_RUN_AS_USER=feishu-sync
APP_FEISHU_KNOWLEDGE_BASE_ID=

# REQUIRED: browser-visible HTTPS endpoints. Vite values are baked into the frontend image.
VITE_HOST_IP=
VITE_APP_ORIGIN=
VITE_API_BASE_URL=
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=enterprise-rag-web
VITE_OIDC_SCOPE=openid profile email

# Optional immutable image naming for deployment/rollback.
APP_IMAGE_NAME=enterprise-rag-api
FRONTEND_IMAGE_NAME=enterprise-rag-web
APP_IMAGE_TAG=latest
