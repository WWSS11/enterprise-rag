# Host IP or hostname reachable by the browser for Keycloak and API.
# Example: 127.0.0.1 or 192.168.1.20
VITE_HOST_IP=127.0.0.1

# Optional full overrides (take precedence over VITE_HOST_IP)
# VITE_OIDC_AUTHORITY=http://127.0.0.1:18080/realms/enterprise-rag
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_APP_ORIGIN=http://localhost:3000

VITE_OIDC_CLIENT_ID=enterprise-rag-web
VITE_OIDC_SCOPE=openid profile email

# Playwright authenticated e2e (never commit real secrets; local Keycloak demo defaults)
# E2E_USERNAME=rag-admin
# E2E_PASSWORD=admin_change_me
